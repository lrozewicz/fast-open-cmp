# Copy to .env for a production-style deploy and REPLACE every value below.
# Used by docker-compose.yml + docker-compose.prod.yml.
#
#   cp .env.prod.example .env   &&   edit .env
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Unlike .env.example (throwaway local creds), these are real secrets — generate
# fresh random values and keep .env out of version control (.gitignore already does).

# Host port the reverse proxy / TLS terminator forwards to (bind to localhost in
# your proxy config; do not expose the container port publicly).
WORDPRESS_PORT=8089

# Database — use long random strings, NOT the words below.
DB_NAME=focmp_prod
DB_USER=focmp_prod
DB_PASSWORD=__CHANGE_ME_strong_random__
DB_ROOT_PASSWORD=__CHANGE_ME_different_strong_random__

# phpMyAdmin is gated behind the "debug" profile in prod and normally not started,
# so PHPMYADMIN_PORT is intentionally omitted here.
