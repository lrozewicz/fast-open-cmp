<?xml version="1.0"?>
<ruleset name="FastOpenCMP-Security">
  <description>
    Security-focused PHPCS gate for the plugin (WordPress Coding Standards).
    Style/formatting sniffs are intentionally out of scope (todo §4) — this gate
    exists to catch the issues from todo §7: unescaped output and unprepared SQL.
  </description>

  <file>.</file>
  <exclude-pattern>*/tests/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>

  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <!-- Output escaping — the main stored-XSS surface (frontend head + SDK output). -->
  <rule ref="WordPress.Security.EscapeOutput"/>

  <!-- SQL: catch values that bypass $wpdb->prepare. -->
  <rule ref="WordPress.DB.PreparedSQL">
    <!--
      Table/column names are interpolated from internal constants
      ($wpdb->prefix . 'cmp_...'), which $wpdb->prepare cannot parameterize and
      which never carry user input; all *values* go through prepare(). Migrating
      these to %i identifier placeholders (WP 6.2+) is tracked separately.
    -->
    <exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared"/>
  </rule>
</ruleset>
