# Copy to .env and adjust. Consumed by docker-compose.yml (local dev only).
# These are NON-SECRET local defaults — do not reuse them in any real deployment.
# .env itself is git-ignored.

# Host ports
WORDPRESS_PORT=8089
PHPMYADMIN_PORT=8090

# Database (WordPress + MariaDB)
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root
